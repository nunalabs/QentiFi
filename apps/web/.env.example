# WalletConnect Project ID
# Get one at: https://cloud.walletconnect.com/
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id_here

# ANDE Network Configuration
NEXT_PUBLIC_ANDE_CHAIN_ID=42069
NEXT_PUBLIC_ANDE_RPC_URL=https://rpc-testnet.ande.network

# Contract Addresses (update after deployment)
NEXT_PUBLIC_FACTORY_ADDRESS=
NEXT_PUBLIC_POOL_MANAGER_ADDRESS=
NEXT_PUBLIC_QENTI_TOKEN_ADDRESS=
NEXT_PUBLIC_STAKING_VAULT_ADDRESS=
NEXT_PUBLIC_NFT_BADGES_ADDRESS=

# IPFS/Pinata Configuration
NEXT_PUBLIC_PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs/
PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET_KEY=your_pinata_secret_key
PINATA_JWT=your_pinata_jwt_token

# The Graph Subgraph URL
NEXT_PUBLIC_SUBGRAPH_URL=https://api.thegraph.com/subgraphs/name/qentifi/qentifi-ande

# Analytics (optional)
NEXT_PUBLIC_GA_TRACKING_ID=
NEXT_PUBLIC_MIXPANEL_TOKEN=

# Feature Flags
NEXT_PUBLIC_ENABLE_TESTNET=true
NEXT_PUBLIC_ENABLE_STAKING=true
NEXT_PUBLIC_ENABLE_NFT_BADGES=true
