# Private key for deployment (DO NOT commit actual key)
PRIVATE_KEY=your_private_key_here

# ANDE Network RPC URLs
ANDE_RPC_URL=https://rpc-testnet.ande.network
ANDE_MAINNET_RPC_URL=https://rpc.ande.network

# Etherscan-equivalent for verification (if available)
ANDE_EXPLORER_API_KEY=your_api_key_here

# Token Distribution Addresses (optional, defaults to deployer)
COMMUNITY_REWARDS=
DAO_TREASURY=
LIQUIDITY_MINING=
TEAM_AND_ADVISORS=
PUBLIC_SALE=

# The Graph
GRAPH_DEPLOY_KEY=your_graph_deploy_key_here

# IPFS/Pinata
PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET_KEY=your_pinata_secret_key
PINATA_JWT=your_pinata_jwt_token

# Frontend
NEXT_PUBLIC_FACTORY_ADDRESS=
NEXT_PUBLIC_POOL_MANAGER_ADDRESS=
NEXT_PUBLIC_QENTI_TOKEN_ADDRESS=
NEXT_PUBLIC_STAKING_VAULT_ADDRESS=
NEXT_PUBLIC_NFT_BADGES_ADDRESS=
NEXT_PUBLIC_ANDE_CHAIN_ID=42069
NEXT_PUBLIC_ANDE_RPC_URL=https://rpc-testnet.ande.network
