{
  "name": "@qentifi/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "QentiFi smart contracts built with Foundry",
  "scripts": {
    "test": "forge test -vvv",
    "test:coverage": "forge coverage",
    "test:gas": "forge test --gas-report",
    "test:fuzz": "forge test --fuzz-runs 10000",
    "build": "forge build",
    "clean": "forge clean",
    "snapshot": "forge snapshot",
    "lint": "solhint 'src/**/*.sol'",
    "format": "forge fmt",
    "deploy:testnet": "forge script script/Deploy.s.sol:DeployScript --rpc-url ande_testnet --broadcast --verify",
    "deploy:mainnet": "forge script script/Deploy.s.sol:DeployScript --rpc-url ande_mainnet --broadcast --verify"
  },
  "devDependencies": {
    "solhint": "^4.1.1"
  }
}
