{
  "name": "qentifi-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "QentiFi - DeFi Hybrid Platform on ANDE Network",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "contracts:test": "pnpm --filter @qentifi/contracts test",
    "contracts:deploy": "pnpm --filter @qentifi/contracts deploy"
  },
  "devDependencies": {
    "prettier": "^3.1.1",
    "turbo": "^1.11.3",
    "typescript": "^5.3.3"
  },
  "packageManager": "pnpm@8.15.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
